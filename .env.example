# Required — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for SEO — your production domain, no trailing slash (e.g. https://promptgen.example.com)
NEXT_PUBLIC_SITE_URL=

# Required for NextAuth JWT signing — generate with: openssl rand -base64 33
AUTH_SECRET=

# Optional — rate limiting on /api/generate (https://console.upstash.com)
# Without these, falls back to per-process in-memory limiting (fine for dev/single-instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required for Google OAuth — https://console.cloud.google.com/
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Required for GitHub OAuth — https://github.com/settings/apps
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Required for magic link auth — get yours at https://resend.com
RESEND_API_KEY=
AUTH_RESEND_FROM=noreply@yourdomain.com

# Optional — send every generated prompt to a Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
